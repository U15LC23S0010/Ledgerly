# =========================================================
# APPLICATION
# =========================================================

APP_ENV=development

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ledgerly-azure-iota.vercel.app


# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=postgresql://username:password@host:5432/database


# =========================================================
# JWT
# =========================================================

SECRET_KEY=replace_with_secure_random_secret

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30


# =========================================================
# ADMIN
# =========================================================

ADMIN_REGISTRATION_CODE=replace_with_secure_admin_code


# =========================================================
# SMTP
# =========================================================

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_USERNAME=your_email@example.com

SMTP_PASSWORD=your_app_password

SMTP_FROM_EMAIL=your_email@example.com

SMTP_FROM_NAME=Ledgerly